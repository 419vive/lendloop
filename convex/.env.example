# Convex deployment environment. These are NOT read from a file:
# set each one with `npx convex env set NAME value` (or in the Convex dashboard).

# Clerk Frontend API URL (Clerk Dashboard → Integrations → Convex), e.g.
# https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Comma-separated, case-insensitive. Matching verified emails get role=admin
# on their next sign-in; removing an email demotes on next sign-in.
ADMIN_EMAILS=you@example.com

# n8n "Request notification" webhook (production URL of the Webhook node).
# Local: http://localhost:5678/webhook/lendloop-request-event
N8N_WEBHOOK_URL=

# HMAC secrets, at least 32 chars each (`openssl rand -hex 32`).
# Must match the same names in n8n/.env. One secret per direction.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
