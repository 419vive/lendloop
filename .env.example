# Next.js app — copy to .env.local (gitignored).
# `npx convex dev` fills in the CONVEX_* / NEXT_PUBLIC_CONVEX_* lines for you.

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (Dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Server-side Convex variables are NOT read from this file.
# Set them on the deployment — see convex/.env.example.
