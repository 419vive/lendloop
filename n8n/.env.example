# Copy to n8n/.env (gitignored). Never commit real values.
# Generate secrets with: openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Keep it stable across restarts.
N8N_ENCRYPTION_KEY=

# Convex signs webhook calls to n8n with this; n8n verifies.
# Must equal CONVEX_TO_N8N_SECRET in the Convex deployment env.
CONVEX_TO_N8N_SECRET=

# n8n signs calls to Convex (and verifies Convex's signed responses) with this.
# Must equal N8N_TO_CONVEX_SECRET in the Convex deployment env.
N8N_TO_CONVEX_SECRET=

# Convex HTTP actions base URL ("site" URL, ends in .convex.site in the cloud).
# Local anonymous deployment, seen from inside Docker:
CONVEX_SITE_URL=http://host.docker.internal:3211
